  // One Cloudflare project: the website (public folder) and the API (src/index.js) share one address.
  "name": "lawlink",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
